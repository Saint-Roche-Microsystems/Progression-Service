# --- Aplicación ---
APP_NAME=Fijazo Progression Service
DEBUG=false
LOG_LEVEL=INFO

# Secreto de servicio a servicio. Sin valor, el servicio no arranca.
INTERNAL_API_KEY=

# --- MongoDB (base propia del servicio) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=progression_service
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# --- bets-service (fuente de verdad de las apuestas, HTTP interno) ---
# Este servicio NO almacena apuestas: las lee de GET /internal/bets de bets-service usando
# el INTERNAL_API_KEY de arriba. Si no responde, el recálculo falla con 503 en vez de
# persistir estadísticas en cero.
BETS_SERVICE_URL=http://localhost:8002
BETS_SERVICE_TIMEOUT_SECONDS=10.0
# Tamaño de página al recorrer el historial. El tope que acepta bets-service es 500.
BETS_PAGE_SIZE=200

# --- RabbitMQ (consumer de progression.recalc, T-026) ---
# Con la URL VACÍA el servicio arranca sin consumer: el recálculo sólo ocurre al llamar a
# POST /internal/recalculate/{user_id}. Sirve para desarrollar sin broker, pero NO debe
# desplegarse así. La cola y su binding los declara rabbitmq/definitions.json.
RABBITMQ_URL=
PROGRESSION_RECALC_QUEUE=progression.recalc
# Mensajes en vuelo por consumer y pausa tras devolver uno a la cola porque bets-service
# no respondía.
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_RETRY_COOLDOWN_SECONDS=5.0

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Observabilidad (Sentry) ---
# DSN del proyecto de Sentry. Vacío = SDK deshabilitado (no rompe el arranque local).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
